#!/usr/bin/env python3
"""Render the status page from what the collector recorded and what the incidents say.

Usage: scripts/build-status --summary <summary.json> --incidents <issues.json> --out <dir>

Reads files rather than calling anything, so the shaping below can be tested without a network
and so the page can be rebuilt from an archived pair of inputs to see what it said on a given
day. The workflow does the fetching.

The output is one self-contained file. No scripts, no external assets, no fonts to fail to
load: a status page whose own availability depends on a CDN is a joke told at its own expense,
and Sordino asks that everything degrade to legible text anyway.
"""

from __future__ import annotations

import argparse
import datetime as dt
import html
import json
import os
import sys

# The window the collector retains, and so the most the page can show.
SPAN_DAYS = 90

OK, DOWN, UNCONFIGURED = "ok", "down", "unconfigured"

# What the banner says, worst case first. Only probed components vote: a deployment that has
# chosen not to run billing is not having a billing outage.
OPERATIONAL = ("All systems operational", "ok")
PARTIAL = ("Some systems are down", "down")
MAJOR = ("Major outage", "down")
UNKNOWN = ("Status unknown", "unknown")


def overall(components: list[dict]) -> tuple[str, str]:
    measured = [c for c in components if c.get("state") in (OK, DOWN)]
    if not measured:
        # Nothing has been observed at all, which is not the same as everything being fine and
        # must never be reported as it.
        return UNKNOWN
    down = [c for c in measured if c["state"] == DOWN]
    if not down:
        return OPERATIONAL
    return MAJOR if len(down) == len(measured) else PARTIAL


def day_slots(days: list[dict], today: dt.date, span: int = SPAN_DAYS) -> list[dict]:
    """One slot per day across the window, oldest first.

    A day with no samples is `None`, never zero and never full. The distinction is the whole
    point: a day nobody checked is not a day that was down, and it is not a day that was up.
    Rendering it as either invents history.
    """
    tallies = {d["date"]: d for d in days}
    slots = []
    for offset in range(span - 1, -1, -1):
        date = (today - dt.timedelta(days=offset)).isoformat()
        tally = tallies.get(date)
        slots.append({"date": date, "tally": tally})
    return slots


def uptime(days: list[dict]) -> dict | None:
    """Checks passed out of checks made, with the denominator kept.

    A bare percentage would be the dishonest form here. The collector's cadence is whatever
    GitHub's scheduler grants it, so "100%" can mean four observations, and a reader deserves
    to see which.
    """
    total = sum(d["total"] for d in days)
    if total == 0:
        return None
    ok = sum(d["ok"] for d in days)
    return {"ok": ok, "total": total, "percent": 100.0 * ok / total}


def observed_cadence(days: list[dict]) -> float | None:
    """Checks per day, measured rather than promised.

    The collector asks to run every ten minutes and does not: scheduled workflows are queued,
    not guaranteed. Whatever the page says about how often it looks has to come from the data.
    """
    if not days:
        return None
    return sum(d["total"] for d in days) / len(days)


def opened_at(item: dict) -> str:
    return item.get("createdAt") or item.get("created_at") or ""


def parse_incidents(issues: list[dict], today: dt.date, span: int = SPAN_DAYS) -> list[dict]:
    """GitHub issues as incidents, newest first.

    Chosen because at three in the morning, on a phone, opening an issue and adding comments is
    realistic and committing files is not. The authoring path has to be the easiest available or
    the log stops being written exactly when it matters.

    Scoped to the same window as the bars, because that is what the rest of the page is about,
    with one exception that matters more than the rule: an incident still open is shown however
    old it is. Ageing out an ongoing outage would be the single worst thing this page could do.
    """
    horizon = (today - dt.timedelta(days=span - 1)).isoformat()
    incidents = []
    for issue in issues:
        closed = issue.get("state") == "closed"
        if closed and opened_at(issue)[:10] < horizon:
            continue
        labels = [l["name"] for l in issue.get("labels", [])]
        # `resolved` is deliberately not readable from a label. Closing the issue is what
        # resolves an incident, so an open issue wearing a stale `resolved` label would
        # otherwise be published as over while it was still happening.
        stage = next((s for s in ("monitoring", "identified", "investigating") if s in labels),
                     None)
        updates = sorted(issue.get("comments", []), key=opened_at)
        incidents.append({
            "title": issue.get("title", "Untitled incident"),
            "url": issue.get("url") or issue.get("html_url", ""),
            "stage": "resolved" if closed else (stage or "investigating"),
            "opened": opened_at(issue)[:10],
            # Sorted on the full timestamp, not the date. Two incidents on one bad day are
            # exactly when the order matters and exactly when a date-only sort gives up.
            "sort_key": opened_at(issue),
            "updates": [
                {"at": opened_at(c)[:16].replace("T", " "), "body": c.get("body", "").strip()}
                for c in updates
            ],
        })
    incidents.sort(key=lambda i: i["sort_key"], reverse=True)
    return incidents


def build(summary: dict, issues: list[dict], today: dt.date, truncated: bool = False) -> dict:
    components = summary.get("components", [])
    banner, tone = overall(components)
    rows = []
    for component in components:
        days = component.get("days", [])
        rows.append({
            "name": component.get("name", component["id"]),
            "description": component.get("description", ""),
            "state": component.get("state", UNCONFIGURED),
            "detail": component.get("detail"),
            "slots": day_slots(days, today),
            "uptime": uptime(days),
            "cadence": observed_cadence(days),
        })
    return {
        "banner": banner,
        "tone": tone,
        "generated_at": summary.get("generated_at"),
        "rows": rows,
        "incidents": parse_incidents(issues, today),
        "truncated": truncated,
        "span": SPAN_DAYS,
    }


# Lifted from web/src/styles/tokens/, not re-picked. The page is a Sotto surface and should
# look like one; a second palette invented here would drift from the app within a release.
STYLE = """
:root {
  --paper: #fbfaf8; --paper-sunk: #f4f2ed;
  --ink: #1a1917; --ink-2: #57544e; --ink-3: #8a867d;
  --hairline: #e4e0d8;
  --link: #2f5fb0;
  --ok: #2f7a4d; --alert: #b23a2e;
  --font-system: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 3rem 1.5rem 6rem;
  background: var(--paper); color: var(--ink);
  font-family: var(--font-system); font-size: 1rem; line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}
main { max-width: 46rem; margin: 0 auto; }
h1 { font-size: 1.75rem; letter-spacing: -0.011em; line-height: 1.2; margin: 0 0 0.25rem; }
h2 { font-size: 1.375rem; line-height: 1.2; margin: 3rem 0 1rem; font-weight: 600; }
h3 { font-size: 1rem; margin: 0; font-weight: 600; }
p { margin: 0 0 1rem; }
a { color: var(--link); }
.meta { color: var(--ink-3); font-size: 0.8125rem; margin: 0; }
.banner { margin: 2rem 0 0; padding: 1rem 1.25rem; border: 1px solid var(--hairline);
          border-radius: 4px; background: #fff; display: flex; align-items: baseline;
          gap: 0.75rem; }
.banner strong { font-size: 1.125rem; font-weight: 600; }
.dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; flex: none; }
.dot.ok { background: var(--ok); } .dot.down { background: var(--alert); }
.dot.unknown, .dot.unconfigured { background: var(--ink-3); }
.component { padding: 1.25rem 0; border-bottom: 1px solid var(--hairline); }
.component:last-of-type { border-bottom: 0; }
.component-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
.state { font-size: 0.8125rem; color: var(--ink-2); white-space: nowrap; }
.desc { color: var(--ink-2); font-size: 0.875rem; margin: 0.125rem 0 0; }
.bars { display: flex; gap: 1px; margin: 0.75rem 0 0.375rem; height: 1.75rem;
        align-items: stretch; }
.bar { flex: 1 1 0; min-width: 1px; border-radius: 1px; background: var(--ok); }
.bar.down { background: var(--alert); }
.bar.partial { background: linear-gradient(var(--alert) 50%, var(--ok) 50%); }
.bar.none { background: var(--paper-sunk); }
.scale { display: flex; justify-content: space-between; color: var(--ink-3); font-size: 0.8125rem; }
.incident { padding: 1.25rem 0; border-bottom: 1px solid var(--hairline); }
.incident:last-of-type { border-bottom: 0; }
.stage { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-2);
         text-transform: uppercase; letter-spacing: 0.02em; }
.update { margin: 0.75rem 0 0; padding-left: 0.875rem; border-left: 2px solid var(--hairline); }
.update time { display: block; font-family: var(--font-mono); font-size: 0.8125rem;
               color: var(--ink-3); }
footer { margin-top: 4rem; color: var(--ink-3); font-size: 0.8125rem; }
@media (prefers-color-scheme: dark) {
  :root { --paper: #16150f; --paper-sunk: #201e17; --ink: #d9d4c6; --ink-2: #b8b3a4;
          --ink-3: #857f6d; --hairline: #2e2b22; --link: #9db6e0;
          --ok: #86b57e; --alert: #e0705f; }
  .banner { background: var(--paper-sunk); }
}
"""


def e(text) -> str:
    # Explicitly None rather than falsy: a legitimate 0 or False is a value to show, and
    # `text or ""` would silently render it as nothing.
    return html.escape("" if text is None else str(text))


def bar_class(tally) -> str:
    if tally is None:
        return "none"
    if tally["ok"] == tally["total"]:
        return ""
    return "down" if tally["ok"] == 0 else "partial"


def bar_title(slot) -> str:
    tally = slot["tally"]
    if tally is None:
        return f"{slot['date']}: not checked"
    return f"{slot['date']}: {tally['ok']} of {tally['total']} checks passed"


def render_component(row: dict) -> str:
    bars = "".join(
        f'<div class="bar {bar_class(s["tally"])}" title="{e(bar_title(s))}"></div>'
        for s in row["slots"]
    )
    if row["uptime"]:
        up = row["uptime"]
        # The denominator is not decoration. At the cadence this actually achieves, "100%" can
        # rest on a handful of observations, and a reader who cannot see how many is being
        # invited to trust a number nobody could stand behind.
        summary = (f'{up["percent"]:.2f}% of {up["total"]} '
                   f'{"check" if up["total"] == 1 else "checks"}')
    else:
        summary = "not measured"
    lines = [row["description"], row["detail"]]
    described = "".join(f'\n        <p class="desc">{e(line)}</p>' for line in lines if line)
    return f"""      <section class="component">
        <div class="component-head">
          <h3>{e(row["name"])}</h3>
          <span class="state"><span class="dot {e(row["state"])}"></span> {e(row["state"])}</span>
        </div>{described}
        <div class="bars" role="img"
             aria-label="{e(row["name"])}: {e(summary)} over the last 90 days">{bars}</div>
        <div class="scale"><span>90 days ago</span><span>{e(summary)}</span><span>today</span></div>
      </section>
"""


def render_incident(incident: dict) -> str:
    updates = "".join(
        f'        <div class="update"><time>{e(u["at"])}</time>{e(u["body"])}</div>\n'
        for u in incident["updates"]
    )
    return f"""      <article class="incident">
        <div class="component-head">
          <h3><a href="{e(incident["url"])}">{e(incident["title"])}</a></h3>
          <span class="stage">{e(incident["stage"])}</span>
        </div>
        <p class="meta">Opened {e(incident["opened"])}</p>
{updates}      </article>
"""


def render(model: dict, now: dt.datetime) -> str:
    components = "".join(render_component(r) for r in model["rows"])
    if model["incidents"]:
        incidents = "".join(render_incident(i) for i in model["incidents"])
    else:
        incidents = ('      <p class="desc">No incidents in the last 90 days. Anything still '
                     'open is listed however old it is.</p>\n')
    if model.get("truncated"):
        # Only reachable if there are more incidents in the window than the fetch asked for.
        # Saying so beats a list that is quietly short: this page is worth exactly as much as
        # its worst unstated omission.
        incidents += ('      <p class="desc">More incidents matched than this page fetched, so '
                      'the list above is incomplete.</p>\n')

    cadences = [r["cadence"] for r in model["rows"] if r["cadence"]]
    if cadences:
        per_day = sum(cadences) / len(cadences)
        # Said plainly rather than as an interval. The collector asks for one every ten minutes
        # and does not get it, so a promised cadence here would be a number this page made up.
        sampling = (f"Uptime is sampled, not measured continuously: about "
                    f"{per_day:.0f} {'check' if round(per_day) == 1 else 'checks'} a day per "
                    f"component so far. A day nobody checked is shown blank rather than green.")
    else:
        sampling = "No checks have been recorded yet."

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Sotto status</title>
<style>{STYLE}</style>
</head>
<body>
<main>
  <h1>Sotto status</h1>
  <p class="meta">Last checked {e(model["generated_at"])}</p>

  <div class="banner">
    <span class="dot {e(model["tone"])}"></span>
    <strong>{e(model["banner"])}</strong>
  </div>

  <h2>Components</h2>
{components}
  <h2>Past incidents</h2>
{incidents}
  <footer>
    <p>{e(sampling)}</p>
    <p>This page is built from the checks in
       <a href="https://github.com/getsotto/sotto">getsotto/sotto</a> and published separately
       from the service it reports on, so it survives the service being gone.
       Built {e(now.strftime("%Y-%m-%dT%H:%M:%SZ"))}.</p>
  </footer>
</main>
</body>
</html>
"""


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--incidents")
    parser.add_argument("--fetch-limit", type=int, default=0,
                        help="how many incidents the caller asked for, so a full page can be "
                             "reported as possibly incomplete rather than silently short")
    parser.add_argument("--out", required=True)
    args = parser.parse_args()

    with open(args.summary, encoding="utf-8") as f:
        summary = json.load(f)
    issues = []
    if args.incidents and os.path.exists(args.incidents):
        with open(args.incidents, encoding="utf-8") as f:
            issues = json.load(f)

    now = dt.datetime.now(dt.timezone.utc)
    truncated = bool(args.fetch_limit) and len(issues) >= args.fetch_limit
    page = render(build(summary, issues, now.date(), truncated), now)
    os.makedirs(args.out, exist_ok=True)
    with open(os.path.join(args.out, "index.html"), "w", encoding="utf-8") as f:
        f.write(page)
    print(f"wrote {os.path.join(args.out, 'index.html')} ({len(page)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
